generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                   @id @default(autoincrement())
  email              String                @unique @db.VarChar(200)
  passwordHash       String                @db.VarChar(500)
  firstName          String                @db.VarChar(100)
  lastName           String                @db.VarChar(100)
  role               String                @db.VarChar(50)
  pin                String?               @db.VarChar(60)
  refreshToken       String?               @db.VarChar(500)
  refreshTokenExpiry DateTime?             @db.Timestamptz(6)
  lastLoginAt        DateTime?             @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime?             @db.Timestamptz(6)
  isActive           Boolean               @default(true)
  auditLogs          AuditLog[]
  closedSessions     CashRegisterSession[] @relation("ClosedBy")
  openedSessions     CashRegisterSession[] @relation("OpenedBy")
  orders             Order[]
  payments           Payment[]

  @@index([email, isActive], map: "IX_Users_Email_Active")
  @@index([role], map: "IX_Users_Role")
  @@map("Users")
}

model Category {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(100)
  description  String?   @db.VarChar(500)
  displayOrder Int       @default(0)
  iconName     String?   @db.VarChar(100)
  /// false = sus productos no pasan por cocina (p. ej. bebidas): quedan "Listo" al enviar el pedido.
  requiresKitchen Boolean @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime? @db.Timestamptz(6)
  isActive     Boolean   @default(true)
  products     Product[]

  @@index([isActive], map: "IX_Categories_IsActive")
  @@map("Categories")
}

model Product {
  id              Int               @id @default(autoincrement())
  categoryId      Int
  name            String            @db.VarChar(200)
  description     String?           @db.VarChar(1000)
  price           Decimal           @db.Decimal(18, 2)
  imageUrl        String?           @db.VarChar(500)
  preparationTime Int?
  isAvailable     Boolean           @default(true)
  displayOrder    Int               @default(0)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime?         @db.Timestamptz(6)
  isActive        Boolean           @default(true)
  orderItems      OrderItem[]
  modifiers       ProductModifier[]
  category        Category          @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([categoryId], map: "IX_Products_CategoryId")
  @@index([isAvailable, isActive], map: "IX_Products_IsAvailable")
  @@map("Products")
}

model ProductModifier {
  id                 Int                 @id @default(autoincrement())
  productId          Int
  name               String              @db.VarChar(100)
  priceAdjustment    Decimal             @default(0) @db.Decimal(18, 2)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime?           @db.Timestamptz(6)
  isActive           Boolean             @default(true)
  orderItemModifiers OrderItemModifier[]
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId], map: "IX_ProductModifiers_ProductId")
  @@map("ProductModifiers")
}

model TableZone {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime? @db.Timestamptz(6)
  isActive    Boolean   @default(true)
  tables      Table[]

  @@map("TableZones")
}

model Table {
  id           Int           @id @default(autoincrement())
  zoneId       Int
  number       Int           @unique(map: "UQ_Tables_Number")
  capacity     Int           @default(4)
  status       String        @default("Libre") @db.VarChar(50)
  positionX    Int?
  positionY    Int?
  shape        String        @default("rectangle") @db.VarChar(50)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime?     @db.Timestamptz(6)
  isActive     Boolean       @default(true)
  orders       Order[]
  reservations Reservation[]
  zone         TableZone     @relation(fields: [zoneId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "IX_Tables_Status")
  @@index([zoneId, number], map: "IX_Tables_ZoneId_Number")
  @@map("Tables")
}

model Order {
  id              Int         @id @default(autoincrement())
  orderNumber     String      @unique @db.VarChar(50)
  tableId         Int?
  waiterId        Int
  status          String      @default("Pendiente") @db.VarChar(50)
  orderType       String      @default("DineIn") @db.VarChar(50)
  subtotal        Decimal     @default(0) @db.Decimal(18, 2)
  taxRate         Decimal     @default(0.15) @db.Decimal(5, 4)
  taxAmount       Decimal     @default(0) @db.Decimal(18, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(18, 2)
  discountPercent Decimal     @default(0) @db.Decimal(5, 2)
  total           Decimal     @default(0) @db.Decimal(18, 2)
  tipAmount       Decimal     @default(0) @db.Decimal(18, 2)
  notes           String?
  customerName    String?     @db.VarChar(200)
  customerPhone   String?     @db.VarChar(50)
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime?   @db.Timestamptz(6)
  isActive        Boolean     @default(true)
  invoice         Invoice?
  items           OrderItem[]
  table           Table?      @relation(fields: [tableId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  waiter          User        @relation(fields: [waiterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments        Payment[]

  @@index([createdAt(sort: Desc)], map: "IX_Orders_CreatedAt")
  @@index([status, isActive], map: "IX_Orders_Status_Active")
  @@index([tableId, isActive], map: "IX_Orders_TableId_Active")
  @@index([waiterId], map: "IX_Orders_WaiterId")
  @@map("Orders")
}

model OrderItem {
  id              Int                 @id @default(autoincrement())
  orderId         Int
  productId       Int
  quantity        Int                 @default(1)
  unitPrice       Decimal             @db.Decimal(18, 2)
  subtotal        Decimal             @db.Decimal(18, 2)
  status          String              @default("Pendiente") @db.VarChar(50)
  notes           String?
  sentToKitchenAt DateTime?           @db.Timestamptz(6)
  readyAt         DateTime?           @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime?           @db.Timestamptz(6)
  isActive        Boolean             @default(true)
  modifiers       OrderItemModifier[]
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product         Product             @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId, isActive], map: "IX_OrderItems_OrderId_Active")
  @@index([productId], map: "IX_OrderItems_ProductId")
  @@index([status], map: "IX_OrderItems_Status")
  @@map("OrderItems")
}

model OrderItemModifier {
  id                Int             @id @default(autoincrement())
  orderItemId       Int
  productModifierId Int
  name              String          @db.VarChar(100)
  priceAdjustment   Decimal         @default(0) @db.Decimal(18, 2)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  orderItem         OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productModifier   ProductModifier @relation(fields: [productModifierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderItemId], map: "IX_OrderItemModifiers_OrderItemId")
  @@map("OrderItemModifiers")
}

model PaymentMethod {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  code      String    @unique @db.VarChar(50)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime? @db.Timestamptz(6)
  isActive  Boolean   @default(true)
  payments  Payment[]

  @@map("PaymentMethods")
}

model Payment {
  id              Int                  @id @default(autoincrement())
  orderId         Int
  paymentMethodId Int
  amount          Decimal              @db.Decimal(18, 2)
  receivedAmount  Decimal?             @db.Decimal(18, 2)
  changeAmount    Decimal?             @db.Decimal(18, 2)
  reference       String?              @db.VarChar(200)
  cashSessionId   Int?
  processedById   Int
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime?            @db.Timestamptz(6)
  isActive        Boolean              @default(true)
  cashSession     CashRegisterSession? @relation(fields: [cashSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order           Order                @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paymentMethod   PaymentMethod        @relation(fields: [paymentMethodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  processedBy     User                 @relation(fields: [processedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cashSessionId], map: "IX_Payments_CashSessionId")
  @@index([createdAt(sort: Desc)], map: "IX_Payments_CreatedAt")
  @@index([orderId], map: "IX_Payments_OrderId")
  @@map("Payments")
}

model CashRegister {
  id        Int                   @id @default(autoincrement())
  name      String                @db.VarChar(100)
  location  String?               @db.VarChar(200)
  createdAt DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt DateTime?             @db.Timestamptz(6)
  isActive  Boolean               @default(true)
  sessions  CashRegisterSession[]

  @@map("CashRegisters")
}

model CashRegisterSession {
  id               Int          @id @default(autoincrement())
  cashRegisterId   Int
  openedById       Int
  closedById       Int?
  openingAmount    Decimal      @default(0) @db.Decimal(18, 2)
  closingAmount    Decimal?     @db.Decimal(18, 2)
  expectedAmount   Decimal?     @db.Decimal(18, 2)
  difference       Decimal?     @db.Decimal(18, 2)
  totalCash        Decimal?     @db.Decimal(18, 2)
  totalCard        Decimal?     @db.Decimal(18, 2)
  totalTransfer    Decimal?     @db.Decimal(18, 2)
  totalSales       Decimal?     @db.Decimal(18, 2)
  transactionCount Int?
  status           String       @db.VarChar(50)
  openedAt         DateTime     @default(now()) @db.Timestamptz(6)
  closedAt         DateTime?    @db.Timestamptz(6)
  notes            String?
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime?    @db.Timestamptz(6)
  isActive         Boolean      @default(true)
  cashRegister     CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  closedBy         User?        @relation("ClosedBy", fields: [closedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  openedBy         User         @relation("OpenedBy", fields: [openedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments         Payment[]

  @@index([openedAt(sort: Desc)], map: "IX_CashSessions_OpenedAt")
  @@index([status], map: "IX_CashSessions_Status")
  @@map("CashRegisterSessions")
}

model Invoice {
  id             Int       @id @default(autoincrement())
  orderId        Int       @unique
  invoiceNumber  String    @unique @db.VarChar(50)
  cai            String?   @db.VarChar(100)
  rangeFrom      String?   @db.VarChar(50)
  rangeTo        String?   @db.VarChar(50)
  expirationDate DateTime? @db.Date
  customerRTN    String?   @db.VarChar(50)
  customerName   String?   @db.VarChar(200)
  subtotal       Decimal   @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(18, 2)
  exemptAmount   Decimal   @default(0) @db.Decimal(18, 2)
  total          Decimal   @default(0) @db.Decimal(18, 2)
  status         String    @db.VarChar(50)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime? @db.Timestamptz(6)
  isActive       Boolean   @default(true)
  order          Order     @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "IX_Invoices_CreatedAt")
  @@index([orderId], map: "IX_Invoices_OrderId")
  @@map("Invoices")
}

model Reservation {
  id              Int       @id @default(autoincrement())
  tableId         Int
  customerName    String    @db.VarChar(200)
  customerPhone   String?   @db.VarChar(50)
  partySize       Int       @default(1)
  reservationDate DateTime  @db.Timestamptz(6)
  notes           String?   @db.VarChar(500)
  status          String    @default("Pendiente") @db.VarChar(50)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime? @db.Timestamptz(6)
  isActive        Boolean   @default(true)
  table           Table     @relation(fields: [tableId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tableId, reservationDate], map: "IX_Reservations_TableId_Date")
  @@map("Reservations")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   Int?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?  @db.VarChar(50)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  user       User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "IX_AuditLogs_CreatedAt")
  @@index([entityType, entityId], map: "IX_AuditLogs_EntityType")
  @@map("AuditLogs")
}
